# Frontend: nur anon/publishable Werte. Keine service-role-Werte mit VITE_ prefix verwenden.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_BASE_PATH=/familien-dashboard/
VITE_VAPID_PUBLIC_KEY=

# Nur lokal oder in geschützten CI-/Admin-Kontexten verwenden.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SEED_FAMILY_NAME=Familie Klein
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_NAME=Admin
SEED_SECOND_EMAIL=adult@example.invalid
SEED_SECOND_NAME=Erwachsene Person
SEED_TEST_PASSWORD=replace-with-a-private-temporary-password

# Supabase Edge Function Secrets, nicht ins Frontend.
VAPID_PRIVATE_KEY={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}
VAPID_ADMIN_CONTACT=mailto:admin@example.invalid
